# Copiar a .env.local y rellenar. NUNCA commitear .env.local
# Las mismas 2 variables van en Vercel → Settings → Environment Variables

# Google AI Studio → https://aistudio.google.com/apikey  (free tier alcanza)
# Solo para VISIÓN (reconocer especie/peso desde foto). Los modelos de Huawei
# de esta hackathon son solo de texto, no tienen capacidad de imagen.
GEMINI_API_KEY=

# Huawei ModelArts MaaS — dado por los organizadores para esta hackathon.
# Usado para el RAG de precios (el núcleo del producto) y extracción de texto.
# Es LA MISMA credencial que INACAP_API_KEY (endpoint INACAP =
# https://api-ap-southeast-1.modelarts-maas.com). Sin esta variable el RAG de
# precios no corre y /api/marketplace/[id]/precio cae al modo degradado.
# Modelos verificados contra la API el 2026-08-14: deepseek-v3.2 (4.9s, JSON
# limpio · default), DeepSeek-V3, deepseek-r1-250528, glm-5, glm-5.1, glm-5.2,
# qwen3-32b. Los deepseek-v4-* existen pero los rechaza el allowlist de la key.
# NINGUNO acepta imagen ni audio: la visión y la voz son solo de Gemini.
MAAS_API_KEY=
# MAAS_MODEL=deepseek-v3.2

# Postgres serverless → https://neon.tech (proyecto nuevo → connection string)
# Por qué no SQLite: Vercel es serverless, el filesystem es efímero.
# Ver docs/03-arquitectura.md, decisión 3.
DATABASE_URL=

# Opcional: fuerza UN solo modelo de visión/voz y desactiva la cadena de
# fallback de src/lib/ai/client.ts (default: gemini-3.5-flash → gemini-3.6-flash
# → gemini-3.5-flash-lite). Los 2.x están deprecados, no usarlos.
# GEMINI_MODEL=gemini-3.6-flash
